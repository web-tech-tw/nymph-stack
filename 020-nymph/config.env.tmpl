# node env ('production' or 'development')
NODE_ENV="production"

# general
TRUST_PROXY="uniquelocal" # empty to disable, ('loopback', 'linklocal', 'uniquelocal' or ip addresses)
ENABLED_PROTOCOLS="http" # ('http', 'https')
ENABLED_REDIRECT_HTTP_HTTPS="no" # redirect http to https ('yes' or 'no')
VIEWS_BASE_URL="/nymph" # base url for views

# http
HTTP_PORT="3000"
HTTP_HOSTNAME="0.0.0.0"

# https
HTTPS_PORT="3500"
HTTPS_HOSTNAME="127.0.0.1"
HTTPS_KEY_PATH="/some/where.key"
HTTPS_CERT_PATH="/some/where.crt"

# database
MONGODB_URI="$NYMPH_MONGODB_URI"
CHROMA_URI="http://chroma:8000"
REDIS_URI="redis://redis:6379"

# cors
ENABLED_CORS="no" # cors ('yes' or 'no'), CORS_ORIGIN is required
ENABLED_CORS_ORIGIN_CHECK="no" # is the API public to every client ('yes' or 'no')
CORS_ORIGIN="https://example.org"

# api docs server
ENABLED_SWAGGER="yes" # swagger ('yes' or 'no')
SWAGGER_SERVER_DESCRIPTION="default"
SWAGGER_CORS_ORIGIN="http://127.0.0.1:3000"
SWAGGER_SERVER_URL="http://127.0.0.1:3000"

# sara config
SARA_RECV_HOST="http://127.0.0.1:3000" # replace the field with your sara.recv entrypoint
SARA_AUDIENCE_URL="https://example.org"

# anthropic integration
ANTHROPIC_API_KEY="$NYMPH_ANTHROPIC_API_KEY"
ANTHROPIC_MODEL="claude-sonnet-5"

# tools integration
TOOL_CODE_EXECUTION_ENABLED="yes"
TOOL_OPEN_WEATHER_MAP_QUERY_RUN_ENABLED="yes"
TOOL_OPEN_WEATHER_MAP_API_KEY="$NYMPH_TOOL_OPEN_WEATHER_MAP_API_KEY"
TOOL_KNOWLEDGE_DOCS_ENABLED="no"
TOOL_KNOWLEDGE_DOCS_GOOGLE_API_KEY="$NYMPH_TOOL_KNOWLEDGE_DOCS_GOOGLE_API_KEY"
TOOL_TAVILY_SEARCH_ENABLED="yes"
TOOL_TAVILY_SEARCH_API_KEY="$NYMPH_TOOL_TAVILY_SEARCH_API_KEY"

# discord integration
DISCORD_APP_ID="921702227016560690"
DISCORD_BOT_TOKEN="$NYMPH_DISCORD_BOT_TOKEN"
DISCORD_GUILD_ID="874338174200074300"
DISCORD_GUILD_ROLE_ID_ADMIN="874647154864582726"
DISCORD_GUILD_CHANNEL_ID_TERMINAL="1214021587964010497"

# matrix integration
MATRIX_HOMESERVER="https://matrix.org"
MATRIX_USERNAME="@nymph57021218:matrix.org"
MATRIX_PASSWORD="$NYMPH_MATRIX_PASSWORD"

# line integration
LINE_CHANNEL_ACCESS_TOKEN="$NYMPH_LINE_CHANNEL_ACCESS_TOKEN"
LINE_CHANNEL_SECRET="$NYMPH_LINE_CHANNEL_SECRET"
