discord:
  token: "${REM_DISCORD_TOKEN}"
  command_prefix: "Rem!"
  mention_only: false
  allow_dms: false
  allowed_channel_ids: ["1478302396940550165"]
  allowed_role_ids: ["1178003691429711992"]
  allowed_strict: true
  presence:
    status: "idle"
    activities:
      - type: "playing"
        name: "☆"

openai:
  chat:
    model: "@noire/mistral-medium-latest"
    api_key: "${REM_OPENAI_API_KEY}"
    base_url: "https://api.portkey.ai/v1"
    extra_body:
      thinking:
        type: "enabled"
      reasoning_effort: "medium"
  vision:
    enabled: true
    model: "@noire/mistral-medium-latest"
    api_key: "${REM_OPENAI_API_KEY}"
    base_url: "https://api.portkey.ai/v1"
  guardrail:
    enabled: true
    model: "@noire/mistral-medium-latest"
    api_key: "${REM_OPENAI_API_KEY}"
    base_url: "https://api.portkey.ai/v1"
    strict_mode: false
    risk_threshold: "high"
    interactive_approval: true
    approval_timeout: 60
    require_approval_level: "high"

memory:
  history_turns: 12
  limit: 24
  db_path: "/data/memory.json"

scheduler:
  db_path: "/data/scheduler.json"

system:
  default_timezone: "Asia/Taipei"

mcp_servers:
  - name: "shell"
    transport: "stdio"
    command: "/usr/local/bin/uvx"
    args: ["--quiet", "mcp-shell-server"]
    env:
      ALLOW_COMMANDS: "docker,git,ls,pwd,grep,find,cat,tail,head,sed,awk,sort,uniq,wc,xargs,tee,tr,cp,mv,rm,mkdir,touch,echo,uname,df,du,whoami,hostname,curl,wget,ssh,scp,rsync"
  - name: "firecrawl"
    transport: "http"
    url: "https://mcp.firecrawl.dev/v2/mcp"
    headers:
      Authorization: "Bearer ${REM_FIRECRAWL_TOKEN}"
