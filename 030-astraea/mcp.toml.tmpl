# Model Context Protocol (MCP) Server Configuration

# HTTP / SSE Server - Fire Crawl
[mcp_servers.firecrawl]
enabled = true
type = "http"
url = "https://mcp.firecrawl.dev/v2/mcp"
headers = { Authorization = "Bearer $ASTRAEA_MCP_FIRECRAWL_TOKEN" }
allowed_tools = [
  "firecrawl_scrape",
  "firecrawl_search",
  "firecrawl_map",
  "firecrawl_developer_search"
]

# HTTP / SSE Server - Twinkle Hub
[mcp_servers.twinkleai]
enabled = true
type = "http"
url = "https://api.twinkleai.tw/mcp/"
headers = { Authorization = "Bearer $ASTRAEA_MCP_TWINKLE_HUB_TOKEN" }

# HTTP / SSE Server - Context7
[mcp_servers.context7]
enabled = true
type = "http"
url = "https://mcp.context7.com/mcp"
headers = { Authorization = "Bearer $ASTRAEA_MCP_CONTEXT_7_TOKEN" }
