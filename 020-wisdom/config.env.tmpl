# database (target knowledge database)
MONGODB_URI="$WISDOM_MONGODB_URI"

# etl source database (archiver)
SOURCE_MONGODB_URI="$WISDOM_SOURCE_MONGODB_URI"
SOURCE_MONGODB_DB_NAME="openchat"
SOURCE_MONGODB_COLLECTIONS="archive-vuejs-plus,archive-line-plus,archive-php-plus,archive-ai-plus,archive-web-tech"

# etl llm integration
ETL_OPENAI_API_KEY="$WISDOM_NIM_API_KEY"
ETL_OPENAI_BASE_URL="https://integrate.api.nvidia.com/v1"
ETL_OPENAI_MODEL="openai/gpt-oss-20b"
ETL_CONCURRENCY="3"

# discord webhook notifications (optional, leave empty to disable)
DISCORD_WEBHOOK_URL="$WISDOM_DISCORD_WEBHOOK_URL"
